{
  "builds": [
    {
      "src": "app/main.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "app/main.py"
    }
  ],
  "env": {
    "STORAGE_PROVIDER": "cloudinary",
    "DATABASE_NULL_POOL": "true",
    "COOKIE_SECURE": "true",
    "COOKIE_SAMESITE": "lax"
  }
}
