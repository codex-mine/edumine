APP_NAME=Codex Edumine API
ENVIRONMENT=development
DEBUG=true

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/codex_edumine

FRONTEND_ORIGINS=["http://localhost:3000"]

RATE_LIMIT_DEFAULT=100/minute
LOGIN_RATE_LIMIT=10/minute

LOG_LEVEL=INFO

JWT_SECRET_KEY=843effaceabdeec0aeedc585479bbd2ec33cee8239f0bdf7c7ed269e74d0152f
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

FRONTEND_URL=http://localhost:3000
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
REGISTER_RATE_LIMIT=5/minute
PASSWORD_RESET_RATE_LIMIT=5/minute

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Codex Edumine

# AI draft-assist for exam question generation (Phase 8). Leave unset to
# disable the draft-assist feature — teachers can still submit questions manually.
ANTHROPIC_API_KEY=

# Generic HTTP SMS gateway (Phase 14). Leave SMS_GATEWAY_URL unset to run
# without a real provider — announcement SMS sends are then logged as
# "failed" in sms_logs rather than falsely reported as delivered.
SMS_GATEWAY_URL=
SMS_GATEWAY_API_KEY=
SMS_SENDER_ID=CodexEdumine

# File storage backend: "local" (default) writes uploads to UPLOAD_DIR and serves
# them from UPLOAD_BASE_URL; "cloudinary" pushes them to Cloudinary instead.
STORAGE_PROVIDER=local

# Required only when STORAGE_PROVIDER=cloudinary — the app refuses to start if
# any of the three is missing, rather than failing on the first upload.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=codex-edumine