APP_NAME=Codex Edumine API
ENVIRONMENT=development
DEBUG=true

# A managed provider's raw connection string is accepted as-is — a
# `postgres://` or `postgresql://` scheme is rewritten to `postgresql+asyncpg://`
# and an `?sslmode=` / `?pgbouncer=` query parameter is translated into the
# equivalent asyncpg connect argument. Prefer the *direct* (non-pooled)
# connection string when running migrations or the seed scripts.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/codex_edumine

# Overrides for what DATABASE_URL implies. DATABASE_SSL takes asyncpg's ssl
# values (disable/prefer/require/verify-ca/verify-full). DATABASE_STATEMENT_CACHE
# defaults to off when the URL looks like a transaction pooler — set it to false
# by hand if you pool through a host that isn't named like one.
DATABASE_SSL=
DATABASE_STATEMENT_CACHE=

# Set true on serverless platforms (Vercel), where the container is frozen
# between requests and a pooled connection rarely survives to the next one.
DATABASE_NULL_POOL=false

FRONTEND_ORIGINS=["http://localhost:3000"]

RATE_LIMIT_DEFAULT=100/minute
LOGIN_RATE_LIMIT=10/minute

LOG_LEVEL=INFO

JWT_SECRET_KEY=843effaceabdeec0aeedc585479bbd2ec33cee8239f0bdf7c7ed269e74d0152f
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

FRONTEND_URL=http://localhost:3000
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
REGISTER_RATE_LIMIT=5/minute
PASSWORD_RESET_RATE_LIMIT=5/minute

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Codex Edumine

# AI draft-assist for exam question generation (Phase 8). Leave unset to
# disable the draft-assist feature — teachers can still submit questions manually.
ANTHROPIC_API_KEY=

# Generic HTTP SMS gateway (Phase 14). Leave SMS_GATEWAY_URL unset to run
# without a real provider — announcement SMS sends are then logged as
# "failed" in sms_logs rather than falsely reported as delivered.
SMS_GATEWAY_URL=
SMS_GATEWAY_API_KEY=
SMS_SENDER_ID=CodexEdumine

# File storage backend: "local" (default) writes uploads to UPLOAD_DIR and serves
# them from UPLOAD_BASE_URL; "cloudinary" pushes them to Cloudinary instead.
STORAGE_PROVIDER=local

# Required only when STORAGE_PROVIDER=cloudinary — the app refuses to start if
# any of the three is missing, rather than failing on the first upload.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=codex-edumine

# OMR answer-sheet scanning. OMR_TEMPLATE_NAME selects a calibrated bubble
# template from app/modules/omr/templates/. Sheets are processed synchronously
# at roughly one second each, so OMR_MAX_SHEETS_PER_REQUEST bounds how long a
# single upload request can run.
OMR_TEMPLATE_NAME=plus_coaching_template
OMR_MAX_SHEETS_PER_REQUEST=20
OMR_SAVE_ANNOTATED_IMAGES=true

# Sheet upload is the most expensive route in the application — each request
# reads up to OMR_MAX_SHEETS_PER_REQUEST high-resolution images and makes two
# Cloudinary round-trips per sheet.
OMR_UPLOAD_RATE_LIMIT=20/minute